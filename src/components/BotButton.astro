---
// Кнопка перехода в бот (SPC-02, разд. 2.4, п. 1). tag — метка страницы: home, about либо код карточки (VM-0104);
// бот ставит её в заявку строкой «Пришёл со страницы». На главной site.js дописывает к метке модель, год и двигатель: home_XC60_2014_d5 (15.11.2026).
import { SITE } from '../../site.config.mjs';
const { tag = 'home', label = SITE.bot.label } = Astro.props;
---
<a id={`botlink-${tag}`} data-tag={tag} class="btn-primary t-button" style="text-align:center;text-decoration:none" href={`${SITE.bot.url}?start=${tag}`} target="_blank" rel="noopener">{label}</a>
