---
// Общий каркас страницы: шапка, подвал, canonical, режим индексации (В-15), JSON-LD.
// Оформление — дизайн-система ЭРА (ERA-MYAVTO-DS-02 0.2): токены public/ds/era-tokens.css, здесь — только слой применений сайта.
// Формат — мобильный, одна колонка 390 px (LOG 09.11.2026, 0.59); на широком экране колонка по центру.
import { SITE } from '../../site.config.mjs';
const B = SITE.base;
import { loadCards } from '../lib/cards';

interface Props {
  title: string;
  description?: string;
  jsonld?: unknown[];
  crumbs?: { title: string; url?: string }[];
  page?: string;
}
const { title, description = '', jsonld = [], crumbs = [], page = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const robots = SITE.mode === 'closed' ? 'noindex, nofollow' : 'index, follow';
const n = loadCards().length;
const org = { '@type': 'Organization', '@id': `${SITE.url}${B}/#operator`, name: SITE.operator.legalName || SITE.operator.name, url: `${SITE.url}${B}/` };
const breadcrumbs = crumbs.length
  ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [{ title: 'Главная', url: B + '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, ...(c.url ? { item: new URL(c.url, SITE.url).href } : {}) })) }
  : null;
const ld = [...jsonld, ...(breadcrumbs ? [breadcrumbs] : [])];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#2B2A35" />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href={B + "/ds/era-tokens.css"} />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <style is:global>
/* ---- Слой применений сайта поверх токенов (собственных токенов нет — DS-01, шаг 7) ---- */
html{background:#15141A}
body{min-height:100vh;display:flex;justify-content:center}
.shell{width:100%;max-width:390px;min-height:100vh;background:var(--era-bg);display:flex;flex-direction:column}
.site{padding:var(--era-step-4) var(--era-gutter);display:flex;flex-direction:column;gap:var(--era-step-4);flex:1}
a{color:inherit}
p{margin:0}
h1,h2,h3,h4{margin:0;font-weight:var(--era-date-weight)}
h1{font-size:var(--era-date-size);line-height:var(--era-date-lh);letter-spacing:var(--era-date-ls)}
h2{font-size:20px;line-height:1.2}
h3{font-size:var(--era-speech-size);line-height:1.3;font-weight:400;margin-top:var(--era-step-4)}
ul,ol{margin:var(--era-step-1) 0 0;padding-left:20px}
li{margin:4px 0}
[hidden]{display:none!important}
/* шапка */
.top{display:flex;align-items:center;justify-content:space-between;gap:var(--era-step-2)}
.brand{letter-spacing:0.3em;text-decoration:none}
.brand .era{color:var(--era-accent)} /* отступление от D1 по указанию владельца (LOG 09.11.2026, 0.66) */
.back{color:var(--era-muted);text-decoration:none;min-height:var(--era-tap);display:inline-flex;align-items:center}
.overline-row{display:flex;align-items:center;justify-content:space-between;gap:var(--era-step-1);margin-top:calc(-1 * var(--era-step-2));position:relative;white-space:nowrap}
.overline-row .t-overline{overflow:hidden;text-overflow:ellipsis}
.city{display:inline-flex;align-items:center;color:var(--era-muted);min-height:var(--era-tap);padding-left:var(--era-step-1)}
.city svg{width:var(--era-icon-sm);height:var(--era-icon-sm);stroke:currentColor;stroke-width:var(--era-icon-stroke);fill:none}
.city-menu{position:absolute;right:0;top:100%;z-index:5;background:var(--era-surface-2);display:grid;min-width:180px}
.city-menu button{display:block;width:100%;text-align:left;padding:0 var(--era-step-3);min-height:var(--era-tap);color:var(--era-text)}
.city-menu button:hover{background:var(--era-surface)}
.city-menu button.alt{border-top:1px solid var(--era-line);color:var(--era-muted)}
.banner{color:var(--era-muted);border-left:var(--era-stripe) solid var(--era-line);padding-left:var(--era-step-3)}
/* текст страниц */
.crumbs{color:var(--era-muted)}
.crumbs a{text-decoration:none}
.lead{color:var(--era-muted)}
.note{color:var(--era-muted)}
.sec{display:flex;flex-direction:column;gap:var(--era-step-2)}
.sec p{margin-top:var(--era-step-1)}
.answer{border-left:var(--era-stripe) solid var(--era-accent);padding-left:calc(var(--era-step-3) + var(--era-step-1));margin-left:calc(-1 * var(--era-gutter));padding-left:calc(var(--era-gutter) - var(--era-stripe))}
.answer p{margin:0}
.fit{color:var(--era-muted)}
.safety{background:var(--era-surface);padding:var(--era-step-3);border-left:var(--era-stripe) solid var(--era-accent)}
.faq details{border-top:1px solid var(--era-line);padding:var(--era-step-2) 0}
.faq summary{cursor:pointer;list-style:none;min-height:var(--era-tap);display:flex;align-items:center}
.faq summary::-webkit-details-marker{display:none}
.faq summary::before{content:"+";color:var(--era-muted);margin-right:var(--era-step-2)}
.faq details[open] summary::before{content:"−"}
.faq details p{margin-top:var(--era-step-1)}
.meta{display:flex;flex-direction:column;gap:4px;color:var(--era-muted);border-top:1px solid var(--era-line);padding-top:var(--era-step-3)}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;vertical-align:top;padding:var(--era-step-2) 0;border-bottom:1px solid var(--era-line)}
th{color:var(--era-muted);font-weight:400;padding-right:var(--era-step-2);width:38%}
code{font-family:ui-monospace,monospace;font-size:0.9em;color:var(--era-muted)}
.open{color:var(--era-muted)}
/* списки карточек */
.list{display:flex;flex-direction:column}
.row{display:flex;flex-direction:column;gap:4px;padding:var(--era-step-3) 0;border-bottom:1px solid var(--era-line);text-decoration:none;color:inherit}
.row .t{font-size:var(--era-input-size);line-height:var(--era-input-lh)}
.row .tags{display:flex;gap:var(--era-step-2);flex-wrap:wrap;color:var(--era-muted)}
.pill{color:var(--era-muted)}
.pill.ok{color:var(--era-text)}
/* оси и чипы */
.axes{display:flex;flex-wrap:wrap;gap:var(--era-step-1);align-items:center}
.axes .t-overline{width:100%}
.axes button,.chips a{min-height:var(--era-tap);padding:0 var(--era-step-3);display:inline-flex;align-items:center;border:1px solid var(--era-line);color:var(--era-muted);text-decoration:none}
.axes button.on{background:var(--era-surface-2);border-color:transparent;border-bottom:var(--era-stripe-h) solid var(--era-accent);color:var(--era-text)}
.chips{display:flex;flex-wrap:wrap;gap:var(--era-step-1)}
/* формы и кнопки */
.pick{display:grid;grid-template-columns:1fr 1fr;gap:var(--era-step-1)}
.field select{width:100%;background:none;border:0;outline:none;color:var(--era-text);appearance:none;-webkit-appearance:none;font:inherit}
.field select.empty{color:var(--era-muted)}
.field.sel{position:relative}
.field.sel::after{content:"";position:absolute;right:var(--era-step-3);top:50%;width:7px;height:7px;border-right:1.5px solid var(--era-muted);border-bottom:1.5px solid var(--era-muted);transform:translateY(-70%) rotate(45deg);pointer-events:none}
.duo{display:grid;grid-template-columns:1fr var(--era-control);gap:var(--era-step-1)}
.composer{display:grid;grid-template-columns:1fr var(--era-control) var(--era-control);gap:var(--era-step-1)}
.btn-primary{display:flex;align-items:center;justify-content:center;height:var(--era-control);width:100%;background:var(--era-surface-2);border-bottom:var(--era-stripe-h) solid var(--era-accent);color:var(--era-text);text-decoration:none}
.hint{margin-top:calc(-1 * var(--era-step-2))}
.push{border-left:var(--era-stripe) solid var(--era-accent)}
/* диалог */
.dialog{display:flex;flex-direction:column;gap:var(--era-step-3);margin-left:calc(-1 * var(--era-gutter));min-height:120px}
.speech .who{display:block;margin-bottom:2px}
.speech.is-prompt{color:var(--era-muted)}
.user{margin-left:var(--era-gutter);background:var(--era-surface-2);border-left:var(--era-stripe) solid var(--era-accent);padding:var(--era-step-2) var(--era-step-3);align-self:flex-end;max-width:85%}
.faqlist{margin-left:var(--era-gutter)}
.faqlist .row{padding:var(--era-step-2) 0}
.dialog .replies{margin-left:var(--era-gutter);margin-top:0}
/* две точки перехода */
.links{display:grid;grid-template-columns:1fr 1fr;gap:var(--era-step-1)}
.link{display:flex;flex-direction:column;gap:var(--era-step-1);background:var(--era-surface);padding:var(--era-step-3);border-bottom:var(--era-stripe-h) solid var(--era-line)}
.link.is-primary{border-bottom-color:var(--era-accent)}
.link .qr{width:124px;height:124px;background:#fff;padding:4px;align-self:center} /* белое поле — требование сканера (LOG 09.11.2026, 0.58) */
.link .qr svg{width:100%;height:100%;display:block}
.link .cap{display:block}
.menu{display:grid;margin-top:var(--era-step-1)}
.menu a{display:block;min-height:var(--era-tap);line-height:var(--era-tap);text-decoration:none;color:var(--era-text);border-top:1px solid var(--era-line)}
@media (hover:none) and (pointer:coarse){.link .qr{display:none}}
/* эксперт */
.exp{display:flex;gap:var(--era-step-3);align-items:center}
.ava{width:52px;height:52px;flex:none;display:grid;place-items:center;background:var(--era-surface-2);border-bottom:var(--era-stripe-h) solid var(--era-accent)}
.foot{color:var(--era-muted);border-top:1px solid var(--era-line);padding-top:var(--era-step-3);margin-top:auto}
.foot a{text-decoration:none;color:var(--era-text)}
    </style>
    <script is:inline set:html={`window.B=${JSON.stringify(B)};window.EXPERT=${JSON.stringify(SITE.expert.name)};`}></script>
  </head>
  <body data-page={page}>
    <div class="shell"><div class="site">
      <div class="top">
        <a class="brand t-label" href={B + "/"}><span class="era">{SITE.brandMark}</span>{SITE.brandRest}</a>
        {page !== 'home' && <a class="back t-meta" href={B + "/"}>← Главная</a>}
      </div>
      {SITE.mode === 'closed' && <p class="banner t-meta">Закрытый тест: {n} карточек, статус «требует подтверждения экспертом». Страницы не индексируются.</p>}
      <slot />
      <p class="foot t-meta">«{SITE.name}» — сайт холдинга ЭРА об эксплуатации и ремонте {SITE.make}; не является официальным ресурсом Volvo Cars. Материалы информационные и не заменяют диагностику у специалиста; решение о ремонте принимает владелец. Ответственность за рекомендации несут оператор сайта и эксперт, указанный в ответе. Оператор: {SITE.operator.legalName || SITE.operator.name}{SITE.operator.inn ? `, ИНН ${SITE.operator.inn}` : ''}. <a href={B + "/about/"}>О проекте</a> · <a href={B + "/pd/"}>Политика ПД</a> · <a href={B + "/llms.txt"}>llms.txt</a></p>
    </div></div>
    <script is:inline src={B + "/js/site.js"}></script>
  </body>
</html>
