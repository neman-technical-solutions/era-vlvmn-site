---
// «О проекте» (NTS-FAB-01 п. 5.3, S6): факты числами из данных; реквизиты оператора — после регистрации.
import Base from '../layouts/Base.astro';
import { loadCards } from '../lib/cards';
import { SITE } from '../../site.config.mjs';
const B = SITE.base;
const cards = loadCards();
const models = new Set(cards.flatMap((c) => c.modelKeys.map((k) => k.model)));
const verified = cards.filter((c) => c.verified).length;
const latest = cards.map((c) => c.modified).sort().at(-1);
const operator = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}${B}/#operator`,
  name: SITE.operator.legalName || SITE.operator.name,
  url: `${SITE.url}${B}/`,
  description: `Картотека по эксплуатации и ремонту Volvo: ${cards.length} карточек, ${models.size} моделей.`,
};
---
<Base title={`О проекте — ${SITE.name}`} jsonld={[operator]} crumbs={[{ title: 'О проекте' }]}>
  <article style="display:flex;flex-direction:column;gap:var(--era-step-3)">
    <p class="crumbs t-meta"><a href={B + "/"}>Главная</a> › О проекте</p>
    <h1 class="t-date">О проекте «{SITE.name}»</h1>
    <p>Картотека по эксплуатации и ремонту автомобилей Volvo: симптом → причины по частоте → что проверить самому → когда к специалисту → запчасти. Сайт — узел холдинга ЭРА на платформе NTS-FAB; не является официальным ресурсом Volvo Cars.</p>
    <h2>Факты</h2>
    <table class="t-meta">
      <tr><th>Начало работы</th><td>ноябрь 2026</td></tr>
      <tr><th>Карточек</th><td>{cards.length}, из них проверено экспертом: {verified}</td></tr>
      <tr><th>Моделей Volvo</th><td>{models.size}</td></tr>
      <tr><th>Последнее изменение картотеки</th><td>{latest}</td></tr>
      <tr><th>Источники</th><td>документация Volvo Cars (руководства владельца); открытые данные техосмотра DVSA 2025 (591 792 теста легковых Volvo, OGL v3.0); опрос мастеров; поиск по открытым источникам с перечнем на странице «Источники» каждой карточки</td></tr>
      <tr><th>Оператор</th><td>{SITE.operator.legalName || <span class="open">регистрация оператора — в работе; до неё персональные данные на сайте не собираются</span>}</td></tr>
      <tr><th>Адрес, реквизиты</th><td>{SITE.operator.address || <span class="open">после регистрации</span>}</td></tr>
    </table>
    <h2>Как делаются карточки</h2>
    <ol>
      <li>Тема — из статистики отказов и вопросов владельцев.</li>
      <li>Текст готовится с помощью ИИ по шаблону и проверяется по открытым источникам; перечень источников и материалы проверки публикуются на странице «Источники» карточки.</li>
      <li>Эксперт по Volvo подтверждает карточку по мере обращений владельцев — после этого она получает знак «проверено экспертом» (предварительной проверки перед публикацией нет, ERA-AN-14).</li>
      <li>Пересмотр — не реже раза в полгода; дата и «что изменено» — на карточке.</li>
    </ol>
    <p class="note t-meta">Ответственность за достоверность информации несут оператор сайта и эксперт, указанный в карточке; за безопасность эксплуатации автомобиля оператор ответственности не несёт.</p>
  </article>
</Base>
