---
// Карточка: HTML-представление (S3), блоки по NTS-FAB-01 табл. 4 и REQ-01 разд. 3, JSON-LD.
// Оформление — дизайн-система ЭРА; вместо партнёрских блоков — две точки перехода (LOG 09.11.2026).
import Base from '../../../layouts/Base.astro';
import Pills from '../../../components/Status.astro';
import { loadCards, md } from '../../../lib/cards';
import { SITE } from '../../../../site.config.mjs';
const B = SITE.base;

export function getStaticPaths() {
  return loadCards().map((c) => ({ params: { slug: c.slug }, props: { card: c } }));
}
const { card } = Astro.props;
const pageUrl = `${SITE.url}${card.url}`;
const sourcesUrl = `${pageUrl}sources/`;
const firstModel = card.modelKeys[0];
const operator = { '@type': 'Organization', '@id': `${SITE.url}${B}/#operator`, name: SITE.operator.legalName || SITE.operator.name, url: `${SITE.url}${B}/` };
const article: Record<string, unknown> = {
  '@context': 'https://schema.org', '@type': 'Article', '@id': pageUrl, mainEntityOfPage: pageUrl,
  headline: card.title, description: card.short, inLanguage: 'ru',
  author: { '@type': 'Organization', name: card.author }, publisher: operator,
  datePublished: card.published, dateModified: card.modified, keywords: card.keywords.join(', '),
  about: card.modelKeys.map((k) => ({ '@type': 'Thing', name: `Volvo ${k.label}` })),
  citation: [sourcesUrl, ...card.sources.filter((s) => /^https?:/.test(s))], isAccessibleForFree: true,
};
if (card.reviewer) article.reviewedBy = { '@type': 'Person', name: card.reviewer, url: `${SITE.url}${SITE.expert.url}` };
const faqPage = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: card.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const crumbs = [...(firstModel ? [{ title: `Volvo ${firstModel.model}`, url: B + `/models/${firstModel.model.toLowerCase()}/` }] : []), { title: card.code }];
const safety = card.sections.find((s) => s.title.startsWith('Когда к специалисту'));
const parts = card.sections.find((s) => s.title.startsWith('Подобрать запчасти'));
const main = card.sections.filter((s) => s !== safety && s !== parts);
function fmt(d: string) { const [y, m, dd] = d.split('-'); return `${dd}.${m}.${y}`; }
---
<Base page="card" title={`${card.title} — ${SITE.name}`} description={card.short.slice(0, 300)} jsonld={[article, faqPage, { '@context': 'https://schema.org', ...operator }]} crumbs={crumbs}>
  <p class="crumbs t-meta"><a href={B + "/"}>Главная</a>{firstModel && <> › <a href={B + `/models/${firstModel.model.toLowerCase()}/`}>{firstModel.model}</a></>} › {card.nodeAxis.title}</p>
  <article style="display:flex;flex-direction:column;gap:var(--era-step-3)">
    <p class="t-overline">Карточка · {card.code}</p>
    <h1 class="t-date">{card.title}</h1>
    <Pills card={card} />
    <div class="answer t-speech" set:html={md(card.short)} />
    <p class="fit t-meta"><b>Для каких исполнений:</b> <span set:html={md(card.applicability).replace(/^<p>|<\/p>\s*$/g, '')} /></p>
    <div class="sec">
      {main.map((s) => (<><h3>{s.title}</h3><div set:html={s.html} /></>))}
      {safety && (<><h3>Когда ехать к специалисту</h3><div class="safety" set:html={safety.html} /></>)}
      {parts && (<><h3>Запчасти к карточке</h3><div set:html={parts.html} /><p class="note t-meta">Ориентир цен, <span class="c">{SITE.city}</span>; артикулы — по комплектации. Подбор и покупка — через эксперта или в приложении.</p></>)}
      <h3>Вопросы и ответы</h3>
      <div class="faq">
        {card.faq.map((f) => (<details><summary set:html={f.qHtml.replace(/^<p>|<\/p>\s*$/g, '')} /><div set:html={f.aHtml} /></details>))}
      </div>
      <h3>Источники</h3>
      <ul class="t-meta">{card.sourcesList.map((s) => <li set:html={md(s).replace(/^<p>|<\/p>\s*$/g, '')} />)}</ul>
      <p class="t-meta"><b>Источники экспертизы:</b> <a href={`${card.url}sources/`}>перечень источников и материалы проверки по карточке</a></p>
    </div>
    <p class="t-meta">Спросить ИИ-механика о своей машине, установить приложение «Мой автомобиль» или связаться с экспертом — <a href={B + "/"}>на первом экране</a>.</p>
    <div class="meta t-meta">
      <span>Опубликовано: {fmt(card.published)}{card.modified !== card.published && <> · изменено: {fmt(card.modified)}</>} · пересмотр до: {fmt(card.review_by)}{card.changelog && <> · {card.changelog}</>}</span>
      <span>Автор: {card.author} · {card.reviewer ? `Подтвердил: ${card.reviewer}` : `Эксперт картотеки: ${SITE.expert.name}`}</span>
      <span>Статус: {card.status}. Числа [Д] — данные (техосмотр DVSA, Великобритания, 2025, лицензия OGL v3.0); [О] — оценка редакции.</span>
      <span>Материал информационный и не заменяет диагностику у специалиста. Текст подготовлен с помощью ИИ; ответственность за рекомендации несут оператор сайта и эксперт, указанный в карточке · <a href={`${card.url}sources/`}>Источники</a> · <a href={B + `/cards/${card.slug}.md`}>Markdown</a></span>
    </div>
  </article>
</Base>
