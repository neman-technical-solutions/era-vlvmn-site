---
// Карточка: HTML-представление (S3), блоки по NTS-FAB-01 табл. 4 и REQ-01 разд. 3, JSON-LD.
import Base from '../../../layouts/Base.astro';
import Status from '../../../components/Status.astro';
import { loadCards, md } from '../../../lib/cards';
import { SITE } from '../../../../site.config.mjs';

export function getStaticPaths() {
  return loadCards().map((c) => ({ params: { slug: c.slug }, props: { card: c } }));
}
const { card } = Astro.props;
const pageUrl = `${SITE.url}${card.url}`;
const sourcesUrl = `${pageUrl}sources/`;
const mdUrl = `${SITE.url}/cards/${card.slug}.md`;
const firstModel = card.modelKeys[0];

const operator = { '@type': 'Organization', '@id': `${SITE.url}/#operator`, name: SITE.operator.legalName || SITE.operator.name, url: `${SITE.url}/` };
// Автор: «редакция ЭРА-Вольвоман» — Organization; именной эксперт появится с reviewer (станция 7).
const author = { '@type': 'Organization', name: card.author };
const article: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': pageUrl,
  mainEntityOfPage: pageUrl,
  headline: card.title,
  description: card.short,
  inLanguage: 'ru',
  author,
  publisher: operator,
  datePublished: card.published,
  dateModified: card.modified,
  keywords: card.keywords.join(', '),
  about: card.modelKeys.map((k) => ({ '@type': 'Thing', name: `Volvo ${k.label}` })),
  citation: [sourcesUrl, ...card.sources.filter((s) => /^https?:/.test(s))],
  isAccessibleForFree: true,
};
if (card.reviewer) article.reviewedBy = { '@type': 'Person', name: card.reviewer };
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: card.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const crumbs = [
  ...(firstModel ? [{ title: `Volvo ${firstModel.model}`, url: `/models/${firstModel.model.toLowerCase()}/` }] : []),
  { title: card.code },
];
const safety = card.sections.find((s) => s.title.startsWith('Когда к специалисту'));
const parts = card.sections.find((s) => s.title.startsWith('Подобрать запчасти'));
const main = card.sections.filter((s) => s !== safety && s !== parts);
function fmt(d: string) { const [y, m, dd] = d.split('-'); return `${dd}.${m}.${y}`; }
---
<Base title={`${card.title} — ${SITE.name}`} description={card.short.slice(0, 300)} jsonld={[article, faqPage, { '@context': 'https://schema.org', ...operator }]} crumbs={crumbs}>
  <article class="paper">
    <p class="crumbs"><a href="/">Главная</a>{firstModel && <> › <a href={`/models/${firstModel.model.toLowerCase()}/`}>{firstModel.model}</a></>} › {card.nodeAxis.title}</p>
    <p class="eyebrow">Карточка · {card.code}</p>
    <h1>{card.title}</h1>
    <Status card={card} />
    <div class="short" set:html={md(card.short)} />
    <p><b>Для каких исполнений:</b> <span set:html={md(card.applicability).replace(/^<p>|<\/p>\s*$/g, '')} /></p>

    {main.map((s) => (
      <section>
        <h2>{s.title}</h2>
        <div set:html={s.html} />
      </section>
    ))}

    {safety && (
      <section>
        <h2>{safety.title}</h2>
        <div class="safety" set:html={safety.html} />
      </section>
    )}

    <section>
      <h2>Вопросы и ответы</h2>
      <dl class="faq">
        {card.faq.map((f) => (
          <>
            <dt set:html={f.qHtml} />
            <dd set:html={f.aHtml} />
          </>
        ))}
      </dl>
    </section>

    {parts && (
      <section>
        <h2>{parts.title}</h2>
        <div set:html={parts.html} />
        <p class="note">Артикулы — по VIN. Подбор под Ваш автомобиль — у поставщика-партнёра:
          {SITE.partnerSupplierUrl
            ? <a class="btn" href={SITE.partnerSupplierUrl} rel="nofollow noopener" target="_blank">Объявления поставщика-партнёра ↗</a>
            : <span class="btn disabled" title="Ссылка на объявления поставщика-партнёра — [ОТКРЫТО]">Объявления поставщика-партнёра</span>}
        </p>
      </section>
    )}

    <section>
      <h2>Источники</h2>
      <ul>{card.sourcesList.map((s) => <li set:html={md(s).replace(/^<p>|<\/p>\s*$/g, '')} />)}</ul>
      <p><b>Источники экспертизы:</b> <a href={`${card.url}sources/`}>перечень источников и материалы проверки по карточке</a></p>
    </section>

    <section class="meta">
      <p>Опубликовано: {fmt(card.published)}{card.modified !== card.published && <> · изменено: {fmt(card.modified)}</>} · пересмотр до: {fmt(card.review_by)}</p>
      {card.changelog && <p>{card.changelog}</p>}
      <p>Автор: {card.author}{card.reviewer ? ` · Подтвердил: ${card.reviewer}` : ' · Подтверждение экспертом — ожидается'} · <a href={`${card.url}sources/`}>Источники</a> · <a href={`/cards/${card.slug}.md`}>Markdown-версия</a></p>
      <p>Статус: {card.status}. Числа [Д] — данные (техосмотр DVSA, Великобритания, 2025, лицензия OGL v3.0); [О] — оценка редакции до опроса мастеров. Материал информационный и не заменяет диагностику у специалиста. Текст подготовлен с помощью ИИ; ответственность за рекомендации несут оператор сайта и эксперт, указанный в карточке.</p>
    </section>
  </article>
</Base>
