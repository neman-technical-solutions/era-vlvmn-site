---
// Страница «Источники» карточки (V-3.8): выдержки из файлов evidence по якорю карточки.
import Base from '../../../layouts/Base.astro';
import { loadCards, evidenceExcerpt } from '../../../lib/cards';
import { SITE } from '../../../../site.config.mjs';
const B = SITE.base;

export function getStaticPaths() {
  return loadCards().map((c) => ({ params: { slug: c.slug }, props: { card: c } }));
}
const { card } = Astro.props;
const excerpts = card.evidence.map((e) => evidenceExcerpt(card, e));
---
<Base title={`Источники карточки ${card.code} — ${SITE.name}`} crumbs={[{ title: card.code, url: card.url }, { title: 'Источники' }]}>
  <article style="display:flex;flex-direction:column;gap:var(--era-step-3)">
    <p class="crumbs t-meta"><a href={B + "/"}>Главная</a> › <a href={card.url}>{card.code}</a> › Источники</p>
    <h1 class="t-date">Источники экспертизы: {card.code}</h1>
    <p class="lead t-meta">{card.title}</p>
    <p class="note t-meta">Два обязательных файла по карточке (ERA-VLVMN-REQ-01, V-3.8): перечень источников, по которым проверены утверждения, и материалы проверки — ответы экспертов или результаты поиска по открытым источникам с датой и исполнителем. Поиск по открытым источникам — оценка [О], не экспертиза; экспертное подтверждение — после утверждения карточки.</p>
    <h2>Первичные источники карточки</h2>
    <ul>{card.sourcesList.map((s) => <li>{s}</li>)}</ul>
    {excerpts.map((x) => (
      <section>
        <h2>{x.title}</h2>
        <p class="note t-meta">Файл: <code>05-content/cards/{x.file}</code></p>
        <div set:html={x.html} />
      </section>
    ))}
    <p><a href={card.url}>← к карточке {card.code}</a></p>
  </article>
</Base>
