---
// Страница «Источники» карточки (V-3.8): выдержки из файлов evidence по якорю карточки.
import Base from '../../../layouts/Base.astro';
import { loadCards, evidenceExcerpt } from '../../../lib/cards';
import { SITE } from '../../../../site.config.mjs';

export function getStaticPaths() {
  return loadCards().map((c) => ({ params: { slug: c.slug }, props: { card: c } }));
}
const { card } = Astro.props;
const excerpts = card.evidence.map((e) => evidenceExcerpt(card, e));
---
<Base title={`Источники карточки ${card.code} — ${SITE.name}`} crumbs={[{ title: card.code, url: card.url }, { title: 'Источники' }]}>
  <article class="paper">
    <p class="crumbs"><a href="/">Главная</a> › <a href={card.url}>{card.code}</a> › Источники</p>
    <h1>Источники экспертизы: {card.code}</h1>
    <p class="lead">{card.title}</p>
    <p class="note">Два обязательных файла по карточке (ERA-VLVMN-REQ-01, V-3.8): перечень источников, по которым проверены утверждения, и материалы проверки — ответы экспертов или результаты поиска по открытым источникам с датой и исполнителем. Поиск по открытым источникам — оценка [О], не экспертиза; экспертное подтверждение — после утверждения карточки.</p>
    <h2>Первичные источники карточки</h2>
    <ul>{card.sourcesList.map((s) => <li>{s}</li>)}</ul>
    {excerpts.map((x) => (
      <section>
        <h2>{x.title}</h2>
        <p class="note">Файл: <code>05-content/cards/{x.file}</code></p>
        <div set:html={x.html} />
      </section>
    ))}
    <p><a href={card.url}>← к карточке {card.code}</a></p>
  </article>
</Base>
