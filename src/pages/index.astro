---
// Первый экран (ERA-VLVMN-MKT-03 0.9, LOG 09.11.2026 ERA-VLVMN-09): наименование, надзаголовок с городом,
// «Механик и контроль ТО» — модель, год, пробег; диалог с ИИ-механиком; две точки перехода; телефон и кнопка контроля ТО (демонстрация).
import Base from '../layouts/Base.astro';
import Links from '../components/Links.astro';
import { loadCards } from '../lib/cards';
import { SITE } from '../../site.config.mjs';
const B = SITE.base;
const cards = loadCards();
// Лёгкий индекс картотеки для диалога: модели, слова, краткий ответ, адрес.
const index = cards.map((c) => ({ code: c.code, title: c.title, url: c.url, models: c.modelKeys.map((k) => k.model), general: c.platform === 'все', keywords: c.keywords, short: c.short }));
const years: number[] = []; for (let y = SITE.years.to; y >= SITE.years.from; y--) years.push(y);
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `${SITE.url}${B}/`, inLanguage: 'ru', publisher: { '@id': `${SITE.url}${B}/#operator` } };
const mic = '<svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>';
---
<Base page="home" title={`Эксплуатация и ремонт ${SITE.make}: ИИ-механик, контроль ТО, карточки по моделям — ${SITE.name}`} description={`ИИ-механик по ${SITE.make}: частые неисправности XC90, XC60, XC70 по данным техосмотра, ближайшее ТО по пробегу, запчасти и расходники. Карточки с источниками, эксперт — ${SITE.expert.name}.`} jsonld={[website]}>
  <div class="overline-row">
    <span class="t-overline">Эксплуатация и ремонт {SITE.make} · <span class="c">{SITE.city}</span></span>
    <button class="city t-overline" type="button" id="city-btn" aria-haspopup="true" aria-expanded="false" aria-label="Выбрать город" onclick="toggleCity()"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></button>
    <span class="city-menu t-input" id="city-menu" hidden>
      {SITE.cities.map((c) => <button type="button" onclick={`setCity(${JSON.stringify(c)})`}>{c}</button>)}
      <button type="button" class="alt" onclick="setCity('Другой город')">Другой город</button>
      <button type="button" class="alt" onclick="setCity('')">Без города</button>
    </span>
  </div>

  <h1 class="t-date">Механик и контроль ТО</h1>
  <div class="pick">
    <label class="field sel t-input"><select id="m" class="empty" onchange="carChanged()" aria-label="Модель"><option value="">Модель</option>{SITE.models.map((m) => <option>{m}</option>)}</select></label>
    <label class="field sel t-input"><select id="y" class="empty" onchange="carChanged()" aria-label="Год выпуска"><option value="">Год</option>{years.map((y) => <option>{y}</option>)}</select></label>
  </div>
  <div class="duo" style="margin-top:calc(-1 * var(--era-step-2))">
    <label class="field t-input"><input id="odo" inputmode="numeric" placeholder="Пробег, км" aria-label="Пробег" oninput="odoTyped()"></label>
    <button class="btn-square" type="button" aria-label="Надиктовать пробег" onclick="voice('odo')" set:html={mic} />
  </div>

  <section class="dialog" id="dialog" aria-label="Диалог с ИИ-механиком">
    <article class="speech is-prompt t-speech"><span class="who t-label">ИИ-механик</span><p>Выберите модель и год — покажу, что чаще всего спрашивают о вашем {SITE.make}. Укажите пробег — отвечу на вопросы по ближайшему ТО. Укажите телефон ниже — поставлю вашу машину на автоматическое напоминание о ТО по пробегу.</p></article>
  </section>
  <form class="composer" onsubmit="return ask()">
    <label class="field t-input"><input id="q" type="text" placeholder="Опишите проблему или задайте вопрос" aria-label="Вопрос ИИ-механику" autocomplete="off"></label>
    <button class="btn-square" type="button" aria-label="Сказать голосом" onclick="voice('q')" set:html={mic} />
    <button class="btn-square is-primary" type="submit" aria-label="Отправить"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  </form>
  <p class="t-meta hint">ИИ-механик может ошибаться.</p>

  <Links />

  <form onsubmit="return toControl()" aria-label="Контроль ТО" style="display:grid;gap:var(--era-step-1)">
    <div class="duo">
      <label class="field t-input"><input id="tel" type="tel" inputmode="tel" placeholder="Телефон" aria-label="Телефон"></label>
      <button class="btn-square" type="button" aria-label="Надиктовать телефон" onclick="voice('tel')" set:html={mic} />
    </div>
    <button class="btn-primary t-button" type="submit">Поставить на контроль ТО</button>
    <p class="t-meta" id="to-hint">Контроль ТО бесплатный, см. <a href={B + "/pd/"}>Политику ПД</a>.{SITE.demo && <> Демонстрация: данные остаются в вашем браузере.</>}</p>
    <div class="push" id="to-ok" hidden><div class="t-label" style="color:var(--era-muted)">Контроль ТО</div><div class="t-meta" id="to-ok-text" style="margin-top:4px;color:var(--era-text)"></div></div>
  </form>

  <section>
    <h2 class="t-label" style="color:var(--era-muted)">Картотека по моделям</h2>
    <div class="chips" style="margin-top:var(--era-step-2)">
      {SITE.models.map((m) => <a class="t-button" href={B + `/models/${m.toLowerCase()}/`}>{m}</a>)}
    </div>
    <p class="note t-meta" style="margin-top:var(--era-step-3)">{cards.length} карточек: симптом → причины по частоте → что проверить самому → когда к специалисту → запчасти. По данным техосмотра DVSA 2025 (591 792 теста легковых Volvo [Д]) и документации Volvo Cars.</p>
  </section>

  <script is:inline set:html={`window.CARDS=${JSON.stringify(index)};window.DEMO=${SITE.demo};`} />
</Base>
