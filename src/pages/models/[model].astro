---
// Раздел модели (REQ-01 V-2.2; экран «Раздел модели» макета 0.53): оси «поколение» и «ситуация» — фильтры списка.
import Base from '../../layouts/Base.astro';
import CardList from '../../components/CardList.astro';
import { cardsByModel, AXES } from '../../lib/cards';
import { SITE } from '../../../site.config.mjs';

export function getStaticPaths() {
  return SITE.models.map((m) => ({ params: { model: m.toLowerCase() }, props: { model: m } }));
}
const { model } = Astro.props;
const cards = cardsByModel(model);
const gens = new Map<string, number>();
for (const c of cards) for (const k of c.modelKeys.filter((k) => k.model === model)) gens.set(k.label, (gens.get(k.label) ?? 0) + 1);
const genList = [...gens.keys()].sort((a, b) => a.localeCompare(b));
const genYears = (label: string) => (AXES.generations as Record<string, string>)[label] ?? '';
const situations = AXES.situations.filter((s) => cards.some((c) => c.situationAxis.slug === s.slug));
---
<Base page="model" title={`Volvo ${model}: неисправности, ТО и запчасти по поколениям — ${SITE.name}`} description={`Карточки по Volvo ${model}: поколения, ситуации, причины по частоте, что проверить самому, запчасти.`} crumbs={[{ title: `Volvo ${model}` }]}>
  <p class="crumbs"><a href="/">Главная</a> › {model}</p>
  <h1>Volvo {model}: неисправности, ТО и запчасти по поколениям</h1>
  <p class="lead">Карточки по модели; общие карточки картотеки показываются здесь же</p>
  {genList.length > 0 && (
    <div class="axes" data-axis="gen"><span class="eyebrow">Поколение</span><button class="on" data-v="">Все</button>{genList.map((g) => <button data-v={g}>{g}{genYears(g) ? ` (${genYears(g)})` : ''}</button>)}</div>
  )}
  {situations.length > 0 && (
    <div class="axes" data-axis="sit"><span class="eyebrow">Ситуация</span><button class="on" data-v="">Все</button>{situations.map((s) => <button data-v={s.slug}>{s.title}</button>)}</div>
  )}
  <CardList cards={cards} model={model} />
  <p class="note" id="empty" hidden>По выбранным поколению и ситуации карточек нет — снимите фильтр или спросите ИИ-механика.</p>
  <p class="note">Нет Вашей ситуации? Спросите ИИ-механика: если карточки нет, тема уйдёт в план, а вопрос — эксперту.</p>
</Base>
