---
// Раздел модели (REQ-01 V-2.2): оси «поколение» и «ситуация» — фильтры списка.
import Base from '../../layouts/Base.astro';
import CardList from '../../components/CardList.astro';
import Links from '../../components/Links.astro';
import { cardsByModel, AXES } from '../../lib/cards';
import { SITE } from '../../../site.config.mjs';
const B = SITE.base;

export function getStaticPaths() {
  return SITE.models.map((m) => ({ params: { model: m.toLowerCase() }, props: { model: m } }));
}
const { model } = Astro.props;
const cards = cardsByModel(model);
const gens = new Map<string, number>();
for (const c of cards) for (const k of c.modelKeys.filter((k) => k.model === model)) gens.set(k.label, (gens.get(k.label) ?? 0) + 1);
const genList = [...gens.keys()].sort((a, b) => a.localeCompare(b));
const genYears = (label: string) => (AXES.generations as Record<string, string>)[label] ?? '';
const situations = AXES.situations.filter((s) => cards.some((c) => c.situationAxis.slug === s.slug));
---
<Base page="model" title={`Volvo ${model}: неисправности, ТО и запчасти по поколениям — ${SITE.name}`} description={`Карточки по Volvo ${model}: поколения, ситуации, причины по частоте, что проверить самому, запчасти.`} crumbs={[{ title: `Volvo ${model}` }]}>
  <p class="crumbs t-meta"><a href={B + "/"}>Главная</a> › {model}</p>
  <h1 class="t-date">Volvo {model}: неисправности, ТО и запчасти</h1>
  <p class="lead t-meta">Карточки по модели и общие карточки картотеки. Спросить ИИ-механика о своей машине — <a href={B + "/"}>на главной</a>.</p>
  {genList.length > 0 && (
    <div class="axes" data-axis="gen"><span class="t-overline">Поколение</span><button class="on t-button" data-v="">Все</button>{genList.map((g) => <button class="t-button" data-v={g}>{g}{genYears(g) ? ` (${genYears(g)})` : ''}</button>)}</div>
  )}
  {situations.length > 0 && (
    <div class="axes" data-axis="sit"><span class="t-overline">Ситуация</span><button class="on t-button" data-v="">Все</button>{situations.map((s) => <button class="t-button" data-v={s.slug}>{s.title}</button>)}</div>
  )}
  <CardList cards={cards} model={model} />
  <p class="note t-meta" id="empty" hidden>По выбранным поколению и ситуации карточек нет — снимите фильтр.</p>
  <Links />
</Base>
