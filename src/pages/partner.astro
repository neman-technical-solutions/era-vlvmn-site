---
// Партнёр: заявка сервису или поставщику (экран «Партнёр» макета 0.53). Демонстрация (Q-4 вариант 3):
// заявка пишется в журнал localStorage, адресата нет. Режим поставщика — ?mode=parts или переход из карточки.
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config.mjs';
const B = SITE.base;
const p = SITE.demoPartners[0];
---
<Base page="partner" title={`Заявка партнёру — ${SITE.name}`} crumbs={[{ title: 'Заявка партнёру' }]}>
  <p class="crumbs"><a href={B + "/"}>Главная</a> › Заявка</p>
  <p class="eyebrow" id="p-eyebrow">Сервис Volvo · <span class="c">{SITE.city}</span></p>
  <h1 id="p-h1">{p.name.replace(' (условно)', '')}: ремонт подвески и диагностика Volvo в {SITE.city} (условно)</h1>
  <p id="p-lead" style="max-width:65ch">Подвеска, ходовая, диагностика. Рабочее время пн–сб 9–20, срок ответа на заявку — до 2 часов (задаёт сервис). Телефон для заявок с сайта: <b style="font-family:var(--mono)">+7 495 ••• 41 07</b> (подменный, с учётом).</p>
  <form class="form">
    <label>Имя<input id="f-name" placeholder="Иван"></label>
    <label>Телефон или Telegram<input id="f-contact" placeholder="+7 9.." required></label>
    <label><span id="f-lbl">Что случилось</span><textarea id="f-txt" rows="3"></textarea></label>
    <label>Когда удобно<select><option>Сегодня</option><option>Завтра</option><option>На неделе</option></select></label>
    <button class="btn" type="submit">Отправить заявку</button><small style="color:var(--muted)">Нажимая «Отправить заявку», Вы соглашаетесь с обработкой персональных данных по <a href={B + "/pd/"}>Политике ПД</a></small>
    <div class="toast" id="ok">Заявка ушла адресату. Ответ — до 2 часов в рабочее время. Переход учтён в статистике карточки</div>
  </form>
  <p class="note">Оператор данных — ООО «ЭРА»; заявка перенаправляется только сервису или поставщику, с которым подписаны договорённости. Сайт хранит факт заявки и карточку-источник.</p>
  {SITE.demo && <p class="note">Закрытый тест: партнёры и подменный номер условные; заявка остаётся в журнале браузера и никому не передаётся.</p>}
</Base>
