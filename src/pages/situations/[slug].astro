---
import Base from '../../layouts/Base.astro';
import CardList from '../../components/CardList.astro';
import { loadCards, AXES } from '../../lib/cards';
import { SITE } from '../../../site.config.mjs';
const B = SITE.base;

export function getStaticPaths() {
  return AXES.situations.map((s) => ({ params: { slug: s.slug }, props: { axis: s } }));
}
const { axis } = Astro.props;
const cards = loadCards().filter((c) => c.situationAxis.slug === axis.slug);
---
<Base title={`Ситуация: ${axis.title} — ${SITE.name}`} crumbs={[{ title: 'Ситуация' }, { title: axis.title }]}>
  <section style="display:flex;flex-direction:column;gap:var(--era-step-3)">
    <p class="crumbs t-meta"><a href={B + "/"}>Главная</a> › Ситуация › {axis.title}</p>
    <h1 class="t-date">{axis.title}: карточки по Volvo</h1>
    <CardList cards={cards} showModels={true} />
  </section>
</Base>
