---
// Карточка из данных «Ближайшее ТО» (макет 0.53, VM-0040): считается в браузере по машине и пробегу с главной.
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config.mjs';
const B = SITE.base;
---
<Base page="to" title={`Ближайшее ТО Volvo: что менять по пробегу и году — ${SITE.name}`} description="Ближайшее ТО Volvo по пробегу и году выпуска: регламент 15 000 км / 12 месяцев, состав работ на 30, 60, 90 и 180 тыс. км." crumbs={[{ title: 'Ближайшее ТО' }]}>
  <div id="gen"><p class="note">Карточка считается по Вашему автомобилю — укажите модель, год и пробег <a href={B + "/"}>на главной</a>.</p></div>
</Base>
